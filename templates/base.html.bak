<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>{% block title %}Dashboard{% endblock %} Â· NeuroRadiomics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="{{ url_for('static', filename='css/style.css') }}" rel="stylesheet">
</head>
<body>
<div class="scrim" id="scrim"></div>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="{{ url_for('dashboard') }}"><span class="logo"><i class="bi bi-cpu"></i></span><span><b>NeuroRadiomics</b><small>Brain tumour AI platform</small></span></a>
    <nav class="side-nav">
      <div class="label">Workspace</div>
      {% set items = [('dashboard','bi-grid-1x2','Dashboard'),('new_analysis','bi-cloud-arrow-up','New MRI analysis'),('viewer_2d','bi-image','2D MRI Viewer'),('viewer_3d','bi-box','3D Segmentation Viewer'),('history','bi-clock-history','Analysis history'),('performance','bi-graph-up','Model performance')] %}
      {% for ep, icon, label in items %}<a class="{{ 'active' if request.endpoint == ep }}" href="{{ url_for(ep) }}"><i class="bi {{ icon }}"></i>{{ label }}</a>{% endfor %}
      {% if exam is defined and exam and exam.id is defined %}
      <div class="label">Examination #{{ exam.id }}</div>
      {% for ep, icon, label in [('results','bi-brightness-high','MRI results viewer'),('radiomics','bi-bar-chart-line','Radiomics analysis'),('evaluate','bi-rulers','Evaluation'),('report','bi-file-earmark-pdf','Reports & export')] %}
      <a class="{{ 'active' if request.endpoint == ep }}" href="{{ url_for(ep, exam_id=exam.id) }}"><i class="bi {{ icon }}"></i>{{ label }}</a>{% endfor %}
      {% endif %}
      <div class="label">Model capabilities</div>
      <a class="{{ 'active' if request.endpoint == 'capabilities' }}" href="{{ url_for('capabilities') }}"><i class="bi bi-cpu"></i>Model capabilities</a>
      <a class="{{ 'active' if request.endpoint == 'classification' }}" href="{{ url_for('classification') }}"><i class="bi bi-diagram-3"></i>Tumour classification</a>
      <a class="{{ 'active' if request.endpoint == 'explainability' }}" href="{{ url_for('explainability') }}"><i class="bi bi-lightbulb"></i>Explainable AI</a>
      <div class="label">Information</div>
      <a class="{{ 'active' if request.endpoint == 'index' }}" href="{{ url_for('index') }}"><i class="bi bi-house"></i>Overview</a>
      <a class="{{ 'active' if request.endpoint == 'about' }}" href="{{ url_for('about') }}"><i class="bi bi-book"></i>Methodology</a>
    </nav>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="btn btn-outline-secondary d-lg-none" id="menuBtn" aria-label="Open menu"><i class="bi bi-list"></i></button>
      <h1>{% block page_title %}{{ self.title() }}{% endblock %}</h1>
      <a class="btn btn-primary btn-sm ms-auto" href="{{ url_for('new_analysis') }}"><i class="bi bi-plus-lg"></i> New MRI analysis</a>
    </header>
    <main class="content">
      {% with messages = get_flashed_messages(with_categories=true) %}
        {% for cat, msg in messages %}<div class="alert alert-{{ cat }} alert-dismissible fade show" role="alert">{{ msg }}<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{% endfor %}
      {% endwith %}
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ url_for('static', filename='js/main.js') }}"></script>
{% block scripts %}{% endblock %}
</body></html>


