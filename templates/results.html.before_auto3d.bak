{% extends "base.html" %}{% block title %}MRI results viewer{% endblock %}
{% block content %}
{% include "_exam_nav.html" %}
<div class="card mb-3"><div class="card-body d-flex flex-wrap gap-3 align-items-center">
  <div class="flex-grow-1"><div class="fw-semibold">U-Net segmentation <span class="chip {{ 'ok' if exam.segmentation else 'warn' }}" id="segChip">{{ 'completed' if exam.segmentation else 'not run' }}</span></div>
    <div class="small text-muted" id="stageText">{{ exam.current_stage or '' }}</div>
    <div class="alert alert-danger small py-1 mt-1 mb-0 {{ '' if exam.error_message else 'd-none' }}" id="errBox">{{ exam.error_message or '' }}</div>
    {% if exam.validation and exam.validation.details %}<div class="small text-muted">Grid {{ exam.validation.details.shape }} · spacing {{ exam.validation.details.voxel_spacing_mm }} mm · orientation {{ exam.validation.details.orientation }}</div>{% endif %}
    {% for w in (exam.warnings or []) %}<div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i> {{ w }}</div>{% endfor %}</div>
  <button class="btn btn-primary" id="segmentBtn" data-url="{{ url_for('segment', exam_id=exam.id) }}" {% if exam.status == 'processing' %}disabled{% endif %}><i class="bi bi-cpu"></i> {{ 'Re-run segmentation' if exam.segmentation else 'Run segmentation' }}</button>
</div></div>

{% if not exam.segmentation %}
<div class="card"><div class="card-body empty text-center py-5"><i class="bi bi-brain fs-1 d-block mb-2"></i>Run the trained U-Net to see the viewer, three-panel comparison and 3D visualization. No placeholder images are shown.</div></div>
{% else %}
<div class="row g-3">
<div class="col-xl-9">
 <div class="card"><div class="card-header pb-0">
  <ul class="nav tabs-line" role="tablist">
   <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab2d" type="button">2D viewer</button></li>
   <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCmp" type="button">Three-panel comparison</button></li>
   <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab3d" type="button">3D brain</button></li>
   <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabXai" type="button">Explainability</button></li></ul></div>
 <div class="card-body tab-content">
  <div class="tab-pane fade show active" id="tab2d">
   <div class="viewer-tools mb-2">
    <select id="vModality" class="form-select form-select-sm w-auto" aria-label="Modality">{% for m in regions %}<option value="{{ m }}" {{ 'selected' if m=='flair' }}>{{ m|upper }}</option>{% endfor %}</select>
    <div class="btn-group btn-group-sm" role="group" aria-label="View" id="vViewGroup"><button class="btn btn-outline-primary active" data-view="axial">Axial</button><button class="btn btn-outline-primary" data-view="coronal">Coronal</button><button class="btn btn-outline-primary" data-view="sagittal">Sagittal</button></div>
    <select id="vRegion" class="form-select form-select-sm w-auto" aria-label="Region"><option value="ALL">All classes</option><option value="WT">Whole tumour (WT)</option><option value="TC">Tumour core (TC)</option><option value="ET">Enhancing tumour (ET)</option></select>
    <select id="vSource" class="form-select form-select-sm w-auto" aria-label="Mask source"><option value="predicted">AI prediction</option>{% if exam.has_ground_truth %}<option value="ground_truth">Ground truth</option>{% endif %}</select>
    <select id="vMode" class="form-select form-select-sm w-auto" aria-label="Display"><option value="overlay">MRI + overlay</option><option value="mri">MRI only</option><option value="mask">Mask only</option></select>
    <div class="btn-group btn-group-sm ms-auto"><button class="btn btn-outline-secondary" id="zIn" title="Zoom in"><i class="bi bi-zoom-in"></i></button><button class="btn btn-outline-secondary" id="zOut" title="Zoom out"><i class="bi bi-zoom-out"></i></button><button class="btn btn-outline-secondary" id="zReset" title="Reset zoom/pan"><i class="bi bi-arrows-angle-contract"></i></button></div></div>
   <div class="viewer-shell"><div id="viewer" style="height:540px" data-url="{{ url_for('slice_data', exam_id=exam.id) }}"></div></div>
   <div class="row align-items-center mt-2 g-2"><div class="col-md-6"><label for="vSlice" class="form-label small mb-0">Slice <b id="sliceLabel"></b> <span class="text-muted">(mouse wheel · drag to pan)</span></label><input type="range" class="form-range" id="vSlice" min="0" max="0" value="0"></div>
    <div class="col-md-6"><label for="vOpacity" class="form-label small mb-0">Overlay opacity <b id="opLabel">0.55</b></label><input type="range" class="form-range" id="vOpacity" min="0" max="1" step="0.05" value="0.55"></div></div>
   <div class="small text-muted" id="orientInfo"></div>
  </div>
  <div class="tab-pane fade" id="tabCmp">
   <div class="viewer-tools mb-2">
    <select id="cModality" class="form-select form-select-sm w-auto" aria-label="Modality">{% for m in regions %}<option value="{{ m }}" {{ 'selected' if m=='flair' }}>{{ m|upper }}</option>{% endfor %}</select>
    <div class="btn-group btn-group-sm" id="cViewGroup"><button class="btn btn-outline-primary active" data-view="axial">Axial</button><button class="btn btn-outline-primary" data-view="coronal">Coronal</button><button class="btn btn-outline-primary" data-view="sagittal">Sagittal</button></div>
    <select id="cRegion" class="form-select form-select-sm w-auto" aria-label="Region"><option value="ALL">All classes</option><option value="WT">WT</option><option value="TC">TC</option><option value="ET">ET</option></select>
    <label class="small ms-2">Opacity <input type="range" class="form-range d-inline-block align-middle" style="width:110px" id="cOpacity" min="0" max="1" step="0.05" value="0.55"></label></div>
   <div class="row g-2">
    <div class="col-lg-4"><div class="viewer-shell"><div class="panel-title">Original MRI</div><div id="cmpMri" style="height:380px"></div></div></div>
    <div class="col-lg-4"><div class="viewer-shell"><div class="panel-title">Ground truth</div><div id="cmpGt" style="height:380px">{% if not exam.has_ground_truth %}<div class="p-4 text-center text-light small">Ground truth was not provided,<br>so this comparison is unavailable.</div>{% endif %}</div></div></div>
    <div class="col-lg-4"><div class="viewer-shell"><div class="panel-title">AI prediction</div><div id="cmpPred" style="height:380px"></div></div></div></div>
   <label for="cSlice" class="form-label small mb-0 mt-2">Slice <b id="cSliceLabel"></b> (identical in all panels)</label><input type="range" class="form-range" id="cSlice" min="0" max="0" value="0">
   {% if not exam.has_ground_truth %}<div class="alert alert-secondary small mb-0">Ground-truth comparison is unavailable for this examination (no mask uploaded).</div>{% endif %}
   <div id="cmpData" data-url="{{ url_for('compare_slice', exam_id=exam.id) }}" data-gt="{{ 1 if exam.has_ground_truth else 0 }}"></div>
  </div>
  <div class="tab-pane fade" id="tab3d">
   <div class="viewer-tools mb-2"><select id="m3Modality" class="form-select form-select-sm w-auto" aria-label="Surface from modality">{% for m in regions %}<option value="{{ m }}" {{ 'selected' if m=='flair' }}>Brain surface: {{ m|upper }}</option>{% endfor %}</select>
    <div class="form-check form-switch ms-2"><input class="form-check-input" type="checkbox" id="brainToggle" checked><label class="form-check-label" for="brainToggle">Brain surface</label></div>
    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="edemaToggle" checked><label class="form-check-label" for="edemaToggle">Edema</label></div>
    <label class="small ms-2">Brain opacity <input type="range" class="form-range d-inline-block align-middle" style="width:110px" id="brainOpacity" min="0.03" max="0.6" step="0.01" value="0.14"></label>
    <button class="btn btn-sm btn-outline-secondary ms-auto" id="m3Reset">Reset camera</button></div>
   <div class="viewer-shell"><div id="plot3d" style="height:560px" data-url="{{ url_for('mesh3d', exam_id=exam.id) }}"></div></div>
   <div class="small text-muted mt-2">Surfaces are computed (marching cubes) from this examination's MRI and its predicted segmentation, in millimetres. Drag to rotate, scroll to zoom, hide the brain to inspect the tumour alone. Tumour: red = necrotic/non-enhancing core, yellow = edema, blue = enhancing. <span id="m3Note"></span></div>
  </div>
  <div class="tab-pane fade" id="tabXai">
   <div class="alert alert-secondary"><b>No explainability output is shown because none can be generated honestly in this project.</b></div>
   <ul class="small"><li><b>Classification:</b> no trained tumour classifier exists in this project, so no class or confidence is displayed.</li>
   <li><b>Grad-CAM++ / segmentation explainability:</b> not implemented for this U-Net; no heatmap is fabricated.</li>
   <li><b>TreeSHAP (radiomics-model explainability):</b> requires a genuine trained tree model (e.g. XGBoost) with documented training data; none is present.</li>
   <li><b>Survival prognosis:</b> omitted – no validated survival model exists.</li></ul>
   <p class="small text-muted mb-0">What is available: visual review of MRI / ground truth / prediction, with a recorded review status (a workflow flag, not clinical approval).</p></div>
 </div></div>
</div>
<div class="col-xl-3">
 <div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center">Tumour measurements
   <select id="mRegion" class="form-select form-select-sm w-auto"><option>WT</option><option>TC</option><option>ET</option></select></div>
  <div class="card-body"><div id="measBox" class="row g-2"><div class="empty">Loading…</div></div>
  <div class="small text-muted mt-2">Physical units from the NIfTI header spacing. Voxel counts are not physical measures.</div></div></div>
 <div class="card mb-3"><div class="card-header">Radiomics summary (WT, PyRadiomics)</div><div class="card-body">
  {% if rad_summary %}<table class="table table-sm mb-2">{% for k, v in rad_summary.items() %}<tr><td>{{ k }}</td><td class="text-end">{{ '%.4g'|format(v) }}</td></tr>{% endfor %}</table>
  {% else %}<p class="empty mb-1">Not computed yet.</p>{% endif %}<a class="btn btn-sm btn-outline-primary" href="{{ url_for('radiomics', exam_id=exam.id) }}">Open radiomics</a></div></div>
 <div class="card mb-3"><div class="card-header">Region volumes</div><div class="card-body small">
  <table class="table table-sm mb-1"><thead><tr><th>Region</th><th>Voxels</th><th class="text-end">mL</th></tr></thead>{% for r in ['WT','TC','ET'] %}<tr><td>{{ r }}</td><td>{{ exam.segmentation.region_voxels[r] }}</td><td class="text-end">{{ '%.3f'|format(exam.segmentation.region_volumes[r]) }}</td></tr>{% endfor %}</table>
  <div class="text-muted">{{ exam.segmentation.device }} · {{ exam.segmentation.inference.stats.elapsed_s }} s inference</div>
  {% for w in (exam.segmentation.qc or []) %}<div class="text-warning-emphasis mt-1"><i class="bi bi-exclamation-triangle"></i> {{ w }}</div>{% endfor %}</div></div>
 <div class="card mb-3"><div class="card-header">Legend</div><div class="card-body small legend"><div><span class="sw" style="background:#e53935"></span>Label 1 · necrotic / non-enhancing core</div><div><span class="sw" style="background:#fdd835"></span>Label 2 · peritumoral edema</div><div><span class="sw" style="background:#1e88e5"></span>Label 4 · enhancing tumour</div><div><span class="sw" style="background:#00e676"></span>Single-region view (WT / TC / ET)</div></div></div>
 <div class="card"><div class="card-header">Human review</div><div class="card-body">
  <form method="post" action="{{ url_for('review', exam_id=exam.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
   <select name="review_status" class="form-select form-select-sm mb-2" aria-label="Review status">{% for v, l in [('not_reviewed','Not reviewed'),('reviewed','Reviewed'),('requires_attention','Requires attention')] %}<option value="{{ v }}" {{ 'selected' if exam.review_status==v }}>{{ l }}</option>{% endfor %}</select>
   <textarea name="review_note" class="form-control form-control-sm mb-2" rows="2" maxlength="500" placeholder="Optional note">{{ exam.review_note or '' }}</textarea><button class="btn btn-sm btn-outline-primary">Save review</button></form>
  <div class="small text-muted mt-1">Workflow flag only – not clinical approval.</div></div></div>
</div></div>
{% endif %}
{% endblock %}
{% block scripts %}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<script>window.EXAM_ID={{ exam.id }};window.STATUS_URL="{{ url_for('status', exam_id=exam.id) }}";window.MEAS_URL="{{ url_for('measurements', exam_id=exam.id) }}";window.HAS_SEG={{ 'true' if exam.segmentation else 'false' }};window.HAS_GT={{ 'true' if exam.has_ground_truth else 'false' }};</script>
<script src="{{ url_for('static', filename='js/viewer.js') }}"></script>
{% endblock %}
