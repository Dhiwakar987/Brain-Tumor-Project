# Copy to .env (or export in your shell). All optional except SECRET_KEY for stable sessions.
SECRET_KEY=change-me-to-a-long-random-string
CHECKPOINT_PATH=model/weights/best_unet_brats.pth
MODEL_CONFIG_PATH=model/model_config.yaml
RADIOMICS_SETTINGS_PATH=radiomics_analysis/settings.yaml
DEVICE=auto               # auto | cpu | cuda
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DATABASE_PATH=outputs/app.db
BACKUP_DIR=backups
MAX_UPLOAD_MB=800
ALLOWED_EXTENSIONS=.nii,.nii.gz
LOG_LEVEL=INFO
INFERENCE_BATCH_SIZE=8
BRATS_DATASET_PATH=       # only used by experiments/ scripts, e.g. D:/data/MICCAI_BraTS2020_TrainingData
ALLOW_UNSAFE_CHECKPOINT_PICKLE=0   # keep 0 unless you fully trust the .pth file
HOST=127.0.0.1
PORT=5000
